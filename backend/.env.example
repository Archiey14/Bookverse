# MongoDB Atlas URI or local MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/bookverse

# Replace this with a long, private value before deployment
JWT_SECRET=replace-with-a-long-random-secret

PORT=5001

# Google OAuth Web client ID (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Razorpay test keys; never commit the real values
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

